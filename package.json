{
  "name": "competitive-intelligence",
  "version": "0.1.0",
  "description": "Competitive intelligence radar — detect signals before they become headlines",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run --config vitest.eval.config.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "docs": "echo 'Docs: README.md, AGENTS.md, ARCHITECTURE.md, docs/'",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run platform:validate",
    "sync:vendored": "node scripts/sync-vendored.mjs",
    "sync:vendored:check": "node scripts/sync-vendored.mjs --check",
    "sync:vendored:freshness": "node scripts/sync-vendored.mjs --freshness",
    "sync:vendored:selftest": "node scripts/sync-vendored.mjs --self-test",
    "schemas:sync": "node scripts/sync-crd-schemas.mjs",
    "schemas:check": "node scripts/sync-crd-schemas.mjs --check",
    "schemas:freshness": "node scripts/sync-crd-schemas.mjs --freshness",
    "platform:validate": "node scripts/validate-platform-manifests.mjs && node scripts/validate-platform-manifests.mjs --self-test",
    "chart:lint": "helm lint chart",
    "chart:template:staging": "helm template competitive-intelligence chart -f chart/values-staging.yaml",
    "chart:template:production": "helm template competitive-intelligence chart -f chart/values-production.yaml",
    "crawl": "tsx src/cli.ts crawl",
    "query": "tsx src/cli.ts query",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@slack/web-api": "^7.19.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "pg": "^8.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.1.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.4",
    "form-data": "^4.0.6",
    "gaxios": "^7.3.0",
    "postcss": "^8.5.15",
    "protobufjs": "^7.6.4",
    "qs": "^6.15.2",
    "undici": "^7.28.0",
    "vite": "^8.0.16",
    "ws": "^8.21.0"
  }
}
