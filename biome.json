{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "extends": ["./biome.base.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!package-lock.json",
      "!docs",
      "!.plans",
      "!chart/templates",
      "!chart/dashboards",
      "!src/vendor",
      "!scripts/sync-vendored.mjs"
    ]
  }
}
