# competitive-intelligence configuration. Copy to .env and fill in for local dev.
#
# In-cluster, these come from External Secrets — not a mounted .env. The Slack
# and provider secrets sync from AWS Secrets Manager at
# competitive-intelligence/<env>/app-secrets (SLACK_BOT_TOKEN, optional
# ANTHROPIC_API_KEY / OPENAI_API_KEY). The pgvector database credentials
# (PGUSER / PGPASSWORD) sync from competitive-intelligence/<env>/db-credentials.
# The chart wires both into the pod via envFrom: secretRef.
#
# For the durable vector backend, set VECTOR_PROVIDER=pgvector and supply either
# DATABASE_URL or the discrete PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD vars.

# ─── Provider Selection ───
LLM_PROVIDER=bedrock              # bedrock (default) | anthropic | openai
EMBEDDING_PROVIDER=bedrock         # bedrock (default) | openai

# ─── AWS Bedrock (uses credential chain — no keys needed) ───
AWS_REGION=us-east-1               # optional (default shown)
BEDROCK_LLM_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0    # optional (default shown)
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0            # optional (default shown)

# ─── Direct API keys + models (only if using anthropic/openai providers) ───
# ANTHROPIC_API_KEY=                       # required when LLM_PROVIDER=anthropic
# OPENAI_API_KEY=                          # required when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai
# ANTHROPIC_LLM_MODEL=claude-sonnet-4-6   # direct-Anthropic model (default shown)
# OPENAI_LLM_MODEL=gpt-4o                  # direct-OpenAI model (default shown)

# ─── Embeddings ───
# EMBEDDING_MODEL=text-embedding-3-small   # OpenAI embedding model (default shown); ignored for bedrock
EMBEDDING_DIMENSIONS=1024          # optional (default 1024) — 1024 for Titan v2, 1536 for OpenAI

# ─── Vector Store ───
VECTOR_PROVIDER=memory             # memory (data lost on restart) | pgvector (durable)
# pgvector connection — either a full URL...
# DATABASE_URL=postgresql://user:pass@host:5432/competitive_intelligence
# ...or the discrete PG* vars (PGUSER/PGPASSWORD come from External Secrets in-cluster)
# PGHOST=
# PGPORT=5432
# PGDATABASE=competitive_intelligence
# PGUSER=
# PGPASSWORD=
# Path to a CA bundle (e.g. the Amazon RDS global CA) for verifying the pgvector
# TLS connection. Unset → Node's built-in trust store (sufficient for RDS/Aurora).
# PG_CA_PATH=/etc/ssl/rds/rds-combined-ca-bundle.pem

# ─── Crawler ───
CRAWL_INTERVAL_MINUTES=60          # optional (default 60)
CRAWL_TIMEOUT_MS=30000             # per-page fetch timeout, optional (default 30000)
USER_AGENT=competitive-intelligence/0.1.0   # crawl request User-Agent, optional (default shown)

# ─── Slack alert sink (optional — alerts log to stderr without it) ───
# Outbound only: the radar posts Block Kit alerts via chat.postMessage. A bot
# token with chat:write is all it needs — no signing secret, no app token.
# SLACK_BOT_TOKEN=xoxb-...
SLACK_ALERT_CHANNEL="#competitive-intel"    # optional (default shown)

# ─── Analysis ───
SIGNIFICANCE_THRESHOLD=0.3        # 0–1, semantic change required to trigger alert (default 0.3)

# ─── Observability (OTel) ───
# In-cluster the chart sets these to the cluster OTel Collector + required resource
# attributes (service.name, deployment.environment, agents.tenant, agents.platform).
# Leave unset locally to fall back to the no-op API.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4318
# OTEL_RESOURCE_ATTRIBUTES=service.name=competitive-intelligence,deployment.environment=development,agents.tenant=strategy,agents.platform=competitive-intelligence
# OTEL_SERVICE_NAME=competitive-intelligence  # service.name; overridden by service.name in OTEL_RESOURCE_ATTRIBUTES if set there
# OTEL_SDK_DISABLED=true            # set true to disable OTel entirely (e.g. local dev)

# ─── Server ───
PORT=3000                          # health-server port — /health + /readyz (default 3000)
MCP_PORT=3001                      # MCP streamable-HTTP server port — the pull/query surface (default 3001)
NODE_ENV=development               # development (default) | production | test
LOG_LEVEL=info                     # debug | info (default) | warn | error

# ─── MCP OAuth 2.1 resource-server protection (optional) ───
# Off by default (MCP_AUTH=none): the MCP port is open, guarded by the mcp-tunnel
# + NetworkPolicy alone. Set MCP_AUTH=workos to require a WorkOS AuthKit bearer
# token on /mcp — this makes the surface addable as a Claude custom connector
# over a public tunnel. WorkOS is the authorization server (configured in its
# dashboard: DCR/CIMD + the MCP URL as a Resource Indicator); this app is only
# the resource server. See docs/mcp-oauth.md.
MCP_AUTH=none                      # none (default) | workos
# WorkOS AuthKit issuer — the `iss` the token must carry and the base its JWKS
# (<issuer>/oauth2/jwks) is fetched from. Required when MCP_AUTH=workos.
# WORKOS_AUTHKIT_ISSUER=https://your-app.authkit.app
# This server's canonical public URL including the /mcp path — the RFC 8707
# resource indicator and the `aud` every accepted token must equal. Required
# when MCP_AUTH=workos. Must be the exact public tunnel URL Claude connects to.
# MCP_PUBLIC_URL=https://competitive-intelligence.example.com/mcp
# Optional space/comma-delimited scopes every request must present (403 if absent).
# MCP_AUTH_SCOPES=
