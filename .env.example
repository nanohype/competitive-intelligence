# competitive-intelligence configuration. Copy to .env and fill in for local dev.
#
# In-cluster, these come from External Secrets — not a mounted .env. The Slack
# and provider secrets sync from AWS Secrets Manager at
# competitive-intelligence/<env>/app-secrets (SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET,
# SLACK_APP_TOKEN, optional ANTHROPIC_API_KEY / OPENAI_API_KEY). The pgvector
# database credentials (PGUSER / PGPASSWORD) sync from
# competitive-intelligence/<env>/db-credentials. The chart wires both into the pod
# via envFrom: secretRef.
#
# For the durable vector backend, set VECTOR_PROVIDER=pgvector and supply either
# DATABASE_URL or the discrete PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD vars.

# ─── Provider Selection ───
LLM_PROVIDER=bedrock              # bedrock (default) | anthropic | openai
EMBEDDING_PROVIDER=bedrock         # bedrock (default) | openai

# ─── AWS Bedrock (uses credential chain — no keys needed) ───
AWS_REGION=us-east-1
BEDROCK_LLM_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# ─── Direct API keys (only if using anthropic/openai providers) ───
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─── Embeddings ───
EMBEDDING_DIMENSIONS=1024          # 1024 for Titan v2, 1536 for OpenAI

# ─── Vector Store ───
VECTOR_PROVIDER=memory             # memory (data lost on restart) | pgvector (durable)
# pgvector connection — either a full URL...
# DATABASE_URL=postgresql://user:pass@host:5432/competitive_intelligence
# ...or the discrete PG* vars (PGUSER/PGPASSWORD come from External Secrets in-cluster)
# PGHOST=
# PGPORT=5432
# PGDATABASE=competitive_intelligence
# PGUSER=
# PGPASSWORD=

# ─── Crawler ───
CRAWL_INTERVAL_MINUTES=60
CRAWL_TIMEOUT_MS=30000
USER_AGENT=competitive-intelligence/0.1.0

# ─── Slack (optional — CLI works without it) ───
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=
# SLACK_APP_TOKEN=xapp-...
SLACK_ALERT_CHANNEL="#competitive-intel"

# ─── Analysis ───
SIGNIFICANCE_THRESHOLD=0.3        # 0–1, semantic change required to trigger alert

# ─── Observability (OTel) ───
# In-cluster the chart sets these to the cluster OTel Collector + required resource
# attributes (service.name, deployment.environment, agents.tenant, agents.platform).
# Leave unset locally to fall back to the no-op API.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4318
# OTEL_RESOURCE_ATTRIBUTES=service.name=competitive-intelligence,deployment.environment=dev,agents.tenant=protohype,agents.platform=competitive-intelligence
# OTEL_SDK_DISABLED=true            # set true to disable OTel entirely (e.g. local dev)

# ─── Server ───
PORT=3000
NODE_ENV=development
LOG_LEVEL=info                     # debug | info | warn | error
